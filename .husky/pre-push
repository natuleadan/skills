#!/usr/bin/env sh
# pre-push: validate the skills before pushing.
# Install: pnpm run prepare (husky)  |  git config core.hooksPath .husky/_
# Bypass:  git push --no-verify   |   HOOK_SKIP=1 git push
[ "${HOOK_SKIP:-0}" = "1" ] && { echo "pre-push: skipped (HOOK_SKIP=1)"; exit 0; }
command -v node >/dev/null 2>&1 || { echo "pre-push: node missing, skip"; exit 0; }
echo "pre-push: node tools/validate-all.ts"
node tools/validate-all.ts
