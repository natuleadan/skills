# Environment Variables for Natuleadan Skills (Local & CI Contract)
# Local dev: copy to .env (git-ignored) and populate required values.
# CI/CD: sync required vars via `gh variable set <KEY> --repo natuleadan/skills`.

# [var] Runtime environment (development | staging | production)
SKILLS_ENV=development
# [var] Logging verbosity (error | warn | info | debug)
SKILLS_LOG_LEVEL=info
